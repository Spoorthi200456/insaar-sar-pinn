# Copy to .env.local and adjust for your deployment.

# Base URL of the FastAPI backend (src/backend/api.py)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base URL for the streaming telemetry endpoint
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Optional: point at a Mapbox style + token instead of the default,
# token-free MapLibre demo style (e.g. "https://api.mapbox.com/styles/v1/<user>/<style>?access_token=<token>")
NEXT_PUBLIC_MAP_STYLE_URL=
